{
  "name": "ai-code-workflow",
  "displayName": "AI Code Workflow",
  "description": "Prepare AI coding requests for ChatGPT, Claude, Gemini, Grok, and other assistants, then preview and apply JSON patches safely in VS Code.",
  "version": "1.1.0",
  "publisher": "vadym-hrynyk",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "ai",
    "chatgpt",
    "claude",
    "gemini",
    "grok",
    "workflow",
    "json",
    "repomix",
    "patch"
  ],
  "activationEvents": [
    "onCommand:aiCodeWorkflow.open"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiCodeWorkflow.open",
        "title": "AI Code Workflow: Open"
      }
    ],
    "configuration": {
      "title": "AI Code Workflow",
      "properties": {
        "aiCodeWorkflow.instructionPath": {
          "type": "string",
          "default": "",
          "description": "Optional custom instruction file path. Relative paths are resolved from the current repository root. Leave empty to use the bundled template."
        },
        "aiCodeWorkflow.repomixCommand": {
          "type": "string",
          "default": "npx",
          "description": "Command used to refresh the project context."
        },
        "aiCodeWorkflow.repomixArgs": {
          "type": "array",
          "default": [
            "repomix"
          ],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed to the project context command."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
