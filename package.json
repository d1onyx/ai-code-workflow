{
  "name": "ai-code-parser",
  "displayName": "AI Code Parser",
  "description": "Apply AI-generated code operations and edits directly inside VS Code with side-by-side diff previews.",
  "version": "1.0.2",
  "publisher": "vadym-hrynyk",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "ai",
    "json",
    "parser",
    "refactor",
    "patch"
  ],
  "activationEvents": [
    "onCommand:aiCodeParser.open"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiCodeParser.open",
        "title": "AI Code Parser: Open"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}